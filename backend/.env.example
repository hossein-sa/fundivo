# Django configuration
DJANGO_SECRET_KEY=replace-with-a-unique-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# PostgreSQL
POSTGRES_DB=fundivo
POSTGRES_USER=fundivo
POSTGRES_PASSWORD=replace-with-a-secure-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Local OTP cache (Redis in Docker)
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing key (generate a different value in your private .env)

JWT_SIGNING_KEY=replace-with-an-independent-random-signing-key
